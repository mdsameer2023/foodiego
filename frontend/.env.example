# Browser-accessible FoodieGo API. No secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Canonical public origin; use your HTTPS frontend domain for deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Razorpay TEST key ID. Never put the key secret in frontend variables.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional restricted browser key; without it the order timeline remains available.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
