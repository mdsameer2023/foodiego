# Copy to .env locally; never commit real values.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# disabled, console (development only), or smtp
EMAIL_MODE=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Explicit administrator bootstrap only:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Razorpay TEST mode only. Keep secrets on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional delivery location write thresholds
TRACKING_MIN_INTERVAL_MS=5000
TRACKING_MIN_DISTANCE_METERS=30
TRACKING_STATIONARY_INTERVAL_MS=30000
# Optional Phase 6 image uploads. Backend secrets only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Estimated earnings per completed delivery, in integer paise; not a payout.
DELIVERY_ESTIMATE_PAISE=5000
# Phase 7. Server-side only. Choose a model available to your Google account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit smoke-test opt in only; not required for normal assistant requests.
GEMINI_LIVE_TEST=0
AI_TIMEOUT_MS=10000
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=500000
# Conversation is never stored on the backend; this controls browser memory expiry.
AI_CHAT_RETENTION_MINUTES=15
# Set to the exact number of trusted reverse proxies in production (Render: 1).
TRUST_PROXY_HOPS=1
